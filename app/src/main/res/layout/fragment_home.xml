<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.codeleg.cashflow.viewmodel.MainViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        tools:context=".ui.fragment.HomeFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SUMMARY CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- HERO ROW -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- LEFT : AMOUNT -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Spent this month"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:alpha="0.85" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tv_total_spent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₹12,540"
                                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnPrimaryContainer" />

                                <!-- STATUS BADGE -->
                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tv_budget_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="SAFE"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:background="@drawable/bg_budget_status"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnPrimary" />
                            </LinearLayout>

                            <!-- RIGHT : CIRCULAR PROGRESS -->
                            <FrameLayout
                                android:layout_width="76dp"
                                android:layout_height="76dp">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/circular_budget"
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    android:progress="68"
                                    app:indicatorSize="72dp"
                                    android:max="100"
                                    app:trackThickness="8dp"
                                    app:indicatorColor="?attr/colorOnPrimaryContainer"
                                    app:trackColor="?attr/colorSurfaceVariant" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text='@{String.format("%.0f%%", viewModel.spentPercentage)}'
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnPrimaryContainer" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- INSIGHT LINE -->
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text='@{"Top spend: " + viewModel.topCategory}'
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.85" />

                        <!-- STATS ROW -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <!-- TRANSACTIONS -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Txns"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:alpha="0.8" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tv_transaction_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="24"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>

                            <!-- HIGHEST -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Highest"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:alpha="0.8" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text='@{String.format("₹%.0f", viewModel.highestExpense)}'
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>

                            <!-- AVERAGE -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Average"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:alpha="0.8" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text='@{String.format("₹%.0f", viewModel.avgExpense)}'
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- RECENT EXPENSES TITLE -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recent Expenses"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <!-- RECYCLER -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_expenses"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_expense" />

                <!-- EMPTY STATE -->
                <ImageView
                    android:id="@+id/noExpenseimg"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_no_expense"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            app:srcCompat="@drawable/outline_add_24"
            app:tint="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
